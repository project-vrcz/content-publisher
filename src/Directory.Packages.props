<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0"/>

        <PackageVersion Include="Sentry" Version="6.12.1"/>
        <PackageVersion Include="Sentry.Serilog" Version="6.12.1"/>

        <PackageVersion Include="Serilog" Version="4.4.0"/>
        <PackageVersion Include="Serilog.Enrichers.Sensitive" Version="2.1.0"/>

        <PackageVersion Include="Sentry.OpenTelemetry.Exporter" Version="6.12.1"/>
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0"/>
        <PackageVersion Include="OpenTelemetry" Version="1.21.0"/>
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2"/>
        
        <PackageVersion Include="Nito.AsyncEx" Version="5.1.2"/>
    </ItemGroup>
</Project>